<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#fff8f2">
  <meta name="description" content="Um convite especial para comemorar os 11 anos da Agatha.">
  <title>Agatha faz 11 anos!</title>
  <link rel="preconnect" href="https://www.canva.com">
  <style>
    :root {
      color-scheme: light;
      --ink: #392638;
      --muted: #765d72;
      --pink: #e94f91;
      --gold: #e7aa50;
      --paper: #fffdfb;
    }
    * { box-sizing: border-box; }
    body {
      min-height: 100vh;
      margin: 0;
      padding: 32px 18px;
      display: grid;
      place-items: center;
      color: var(--ink);
      font-family: ui-rounded, "Avenir Next", Avenir, "Segoe UI", sans-serif;
      background:
        radial-gradient(ellipse at 12% 15%, rgba(255, 196, 220, .58), transparent 34%),
        radial-gradient(ellipse at 90% 85%, rgba(255, 221, 166, .58), transparent 34%),
        #fff8f2;
    }
    main { width: min(100%, 620px); text-align: center; }
    .eyebrow {
      margin: 0 0 10px;
      color: var(--pink);
      font-size: .78rem;
      font-weight: 800;
      letter-spacing: .19em;
      text-transform: uppercase;
    }
    h1 {
      margin: 0;
      font-size: clamp(2.6rem, 10vw, 5.3rem);
      line-height: .98;
      letter-spacing: -.065em;
    }
    h1 span { color: var(--pink); }
    .intro {
      margin: 16px 0 24px;
      color: var(--muted);
      font-size: clamp(1rem, 3vw, 1.2rem);
      line-height: 1.55;
    }
    .invite {
      width: min(100%, 420px);
      margin: 0 auto;
      padding: 10px;
      border: 1px solid rgba(90, 57, 77, .1);
      border-radius: 22px;
      background: var(--paper);
      box-shadow: 0 20px 60px rgba(98, 47, 78, .14);
    }
    .frame {
      position: relative;
      width: 100%;
      height: 0;
      padding-top: 177.7778%;
      overflow: hidden;
      border-radius: 15px;
      background: #f5e9ef;
    }
    iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }
    .open-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 48px;
      margin-top: 20px;
      padding: 0 22px;
      border-radius: 999px;
      color: white;
      background: var(--pink);
      box-shadow: 0 8px 20px rgba(233, 79, 145, .24);
      font-weight: 750;
      text-decoration: none;
      transition: transform .18s ease, box-shadow .18s ease;
    }
    .open-link:hover { transform: translateY(-2px); box-shadow: 0 12px 25px rgba(233, 79, 145, .3); }
    .open-link:focus-visible { outline: 3px solid var(--gold); outline-offset: 4px; }
    footer { margin-top: 24px; color: var(--muted); font-size: .88rem; }
    .sparkle { color: var(--gold); }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; }
    }
  </style>
</head>
<body>
  <main>
    <p class="eyebrow">Você está convidado</p>
    <h1>Agatha <span>faz 11!</span></h1>
    <p class="intro">Uma comemoração muito especial está chegando.<br>Assista ao convite e venha celebrar com a gente!</p>

    <section class="invite" aria-label="Convite de aniversário em vídeo">
      <div class="frame">
        <iframe
          src="https://www.canva.com/design/DAHadqhEqXU/ActWqtEeakzoJKZiqiRu-w/watch?embed"
          title="Convite em vídeo: Agatha faz 11 anos"
          loading="lazy"
          allow="fullscreen"
          allowfullscreen>
        </iframe>
      </div>
    </section>

    <a class="open-link"
       href="https://www.canva.com/design/DAHadqhEqXU/ActWqtEeakzoJKZiqiRu-w/watch?utm_content=DAHadqhEqXU&amp;utm_campaign=designshare&amp;utm_medium=embeds&amp;utm_source=link"
       target="_blank" rel="noopener noreferrer">
      Abrir convite no Canva <span aria-hidden="true">↗</span>
    </a>

    <footer><span class="sparkle" aria-hidden="true">✦</span> Feito com carinho por Adri Ribeiro <span class="sparkle" aria-hidden="true">✦</span></footer>
  </main>
</body>
</html>
